{
  "swagger": "2.0",
  "info": {
    "title": "Contacts API",
    "description": "API documentation for creating, reading, updating, and deleting contacts.",
    "version": "1.0.0"
  },
  "host": "localhost:3000",
  "basePath": "/contacts",
  "schemes": [
    "http"
  ],
  "paths": {
    "/": {
      "get": {
        "tags": [
          "Contacts"
        ],
        "summary": "Get all contacts",
        "description": "Returns every contact stored in MongoDB.",
        "responses": {
          "200": {
            "description": "Contacts retrieved successfully.",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Contact"
              },
              "xml": {
                "name": "main"
              }
            }
          },
          "500": {
            "description": "Internal server error."
          }
        }
      },
      "post": {
        "tags": [
          "Contacts"
        ],
        "summary": "Create a contact",
        "description": "Creates a new contact in MongoDB. All fields are required.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "description": "Contact information",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ContactInput"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Contact created successfully.",
            "schema": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "example": "6aa4bceaf5f8fef71b9316b5"
                }
              },
              "xml": {
                "name": "main"
              }
            }
          },
          "400": {
            "description": "Missing or invalid fields."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
    "/{id}": {
      "get": {
        "tags": [
          "Contacts"
        ],
        "summary": "Get one contact",
        "description": "Returns one contact using its MongoDB ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "MongoDB ID of the contact"
          }
        ],
        "responses": {
          "200": {
            "description": "Contact retrieved successfully.",
            "schema": {
              "$ref": "#/definitions/Contact"
            }
          },
          "400": {
            "description": "Invalid contact ID."
          },
          "404": {
            "description": "Contact not found."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      },
      "put": {
        "tags": [
          "Contacts"
        ],
        "summary": "Update a contact",
        "description": "Updates an existing contact using its MongoDB ID. All fields are required.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "MongoDB ID of the contact"
          },
          {
            "name": "body",
            "in": "body",
            "description": "Updated contact information",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ContactInput"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Contact updated successfully."
          },
          "400": {
            "description": "Invalid ID or missing fields."
          },
          "404": {
            "description": "Contact not found."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      },
      "delete": {
        "tags": [
          "Contacts"
        ],
        "summary": "Delete a contact",
        "description": "Deletes an existing contact using its MongoDB ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "MongoDB ID of the contact"
          }
        ],
        "responses": {
          "204": {
            "description": "Contact deleted successfully."
          },
          "400": {
            "description": "Invalid contact ID."
          },
          "404": {
            "description": "Contact not found."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    }
  },
  "definitions": {
    "Contact": {
      "type": "object",
      "properties": {
        "_id": {
          "type": "string",
          "example": "6aa4bceaf5f8fef71b9316b5"
        },
        "firstName": {
          "type": "string",
          "example": "David"
        },
        "lastName": {
          "type": "string",
          "example": "Canales"
        },
        "email": {
          "type": "string",
          "example": "david@example.com"
        },
        "favoriteColor": {
          "type": "string",
          "example": "Blue"
        },
        "birthday": {
          "type": "string",
          "example": "January 1, 2000"
        }
      }
    },
    "ContactInput": {
      "type": "object",
      "properties": {
        "firstName": {
          "type": "string",
          "example": "David"
        },
        "lastName": {
          "type": "string",
          "example": "Canales"
        },
        "email": {
          "type": "string",
          "example": "david@example.com"
        },
        "favoriteColor": {
          "type": "string",
          "example": "Blue"
        },
        "birthday": {
          "type": "string",
          "example": "January 1, 2000"
        }
      }
    }
  }
}